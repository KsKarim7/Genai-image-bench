# Copy to .env and fill in whichever you have. Providers without a key are skipped
# and the run continues with the rest — Pollinations needs no key at all, so the
# harness does something useful before you configure anything.

# Google AI Studio key — https://aistudio.google.com/apikey
# Powers gemini-2.5-flash-image, which is PAID ONLY: Google's pricing page lists
# "Free Tier: Not available" for it (checked 2026-10-09). A key without billing
# enabled will not generate. The model is also deprecated, shutdown 2027-03-15.
GOOGLE_API_KEY=

# Hugging Face token — https://huggingface.co/settings/tokens
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
