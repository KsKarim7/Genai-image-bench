# Copy to .env and fill in whichever you have. Providers without a key are skipped
# and the run continues with the rest — Pollinations needs no key at all, so the
# harness does something useful before you configure anything.

# Google AI Studio key — https://aistudio.google.com/apikey
# Powers both Gemini image models, which share this key and so share one rate gate:
#   gemini-3.1-flash-lite-image   $0.0336/image
#   gemini-3.1-flash-image        $0.067/image
# PAID ONLY: Google lists "Free Tier: Not available" for every Gemini image model
# (checked 2026-10-09), so a key without billing enabled will not generate.
GOOGLE_API_KEY=

# Hugging Face token — https://huggingface.co/settings/tokens
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
