# core.autocrlf=true was rewriting source line endings per-checkout; pin them.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary

# Committed run images carry no extension on purpose, so no suffix rule can
# match them and nothing but content sniffing would stop eol normalisation
# from corrupting the bytes. State it.
runs/**/images/** binary
