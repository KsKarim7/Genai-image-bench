.env
.venv/
venv/
__pycache__/
*.pyc
.DS_Store

# Generations are unseeded, so a run cannot be reproduced — committing one is how
# the blind-scoring claim stays checkable. Whitelisted, not default, so it is a
# deliberate act and not whatever `git add .` happened to sweep up.
runs/*
!runs/.gitkeep
!runs/reference/
